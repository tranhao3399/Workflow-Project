  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:reset:dev": "node --env-file=.env ./scripts/reset-development-data.mjs",
    "db:migrate:user-role-ids": "node --env-file=.env ./scripts/migrate-user-role-ids.mjs",
    "db:migrate:core-collections": "node --env-file=.env ./scripts/migrate-core-collections.mjs",
    "db:migrate:notification-audit-indexes": "node --env-file=.env ./scripts/migrate-notification-audit-indexes.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
